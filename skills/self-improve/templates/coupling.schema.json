{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["couplings"],
  "properties": {
    "couplings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "impacts"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "trigger": { "type": "string" },
          "impacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "kind", "why"],
              "properties": {
                "target": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "array", "minItems": 1, "items": { "type": "string" } }
                  ]
                },
                "kind": { "enum": ["change-required", "new-code-required"] },
                "why": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
