/**
 * reactbits-adapter.js — frame-locks reactbits backgrounds for HyperFrames render.
 *
 * THE PROBLEM
 * Reactbits backgrounds animate via requestAnimationFrame + performance.now().
 * HyperFrames renders by stepping a headless Chromium frame-by-frame and seeking
 * the GSAP global timeline to each frame. Dropped in raw, every captured frame
 * would show the same uTime — the background is FROZEN in the rendered mp4 even
 * though it animates fine in preview.
 *
 * THE FIX
 * Every reactbits component, after `npx shadcn add @react-bits/<Name>-JS-CSS`,
 * must be patched so its render loop registers with __reactbitsRegistry instead
 * of running its own requestAnimationFrame loop. This adapter then dispatches
 * "tick(time)" to every registered component on every gsap.ticker tick — which
 * during render is one tick per video frame.
 *
 * USAGE (inside a scene's <script>):
 *
 *   import "../../reactbits-adapter.js";  // sets up window.__reactbitsRegistry
 *   import Aurora from "../../components/Aurora/Aurora.jsx";
 *
 *   const root = createRoot(document.querySelector('[data-reactbits-mount="aurora-1"]'));
 *   root.render(<Aurora colorStops={["#0066ff", "#8b5cf6"]} mouseInteraction={false} />);
 *
 *   // Inside the patched Aurora.jsx, replace the rAF loop with:
 *   //   window.__reactbitsRegistry.register((time) => {
 *   //     program.uniforms.uTime.value = time;
 *   //     renderer.render({ scene: mesh });
 *   //   });
 */

(function setupReactbitsRegistry(global) {
  if (global.__reactbitsRegistry) return;

  const callbacks = new Set();

  function register(cb) {
    callbacks.add(cb);
    return () => callbacks.delete(cb);
  }

  function tick() {
    // gsap.globalTimeline.totalTime() is frame-locked under hyperframes render.
    // During preview it advances in real time. Either way, every patched
    // background sees a monotonic, deterministic time source.
    const time = global.gsap?.globalTimeline?.totalTime?.() ?? performance.now() / 1000;
    callbacks.forEach((cb) => {
      try { cb(time); } catch (err) { console.error("[reactbits-adapter] tick error:", err); }
    });
  }

  global.__reactbitsRegistry = {
    register,
    tick,
    _callbacks: callbacks,  // exposed for debug only
  };

  // Hook into GSAP ticker so registered backgrounds advance whenever GSAP advances.
  // This is the load-bearing line — it's what makes the backgrounds frame-deterministic
  // during hyperframes render.
  if (global.gsap?.ticker?.add) {
    global.gsap.ticker.add(tick);
  } else {
    // Fallback for the rare case where gsap loaded after this module — wait one frame.
    requestAnimationFrame(() => {
      if (global.gsap?.ticker?.add) global.gsap.ticker.add(tick);
      else console.warn("[reactbits-adapter] gsap.ticker not found — backgrounds will use wall-clock time and freeze under render.");
    });
  }
})(typeof window !== "undefined" ? window : globalThis);

/**
 * Mouse-position freezer for components that read mouse position from
 * window/document directly (some reactbits components don't gate this behind
 * a prop). Call once at scene setup. Sets pointer reads to canvas center.
 */
export function freezeCursor() {
  let frozenX = window.innerWidth / 2;
  let frozenY = window.innerHeight / 2;
  Object.defineProperty(window, "mouseX", { get: () => frozenX, configurable: true });
  Object.defineProperty(window, "mouseY", { get: () => frozenY, configurable: true });
}
